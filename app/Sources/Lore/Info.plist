    <string>Lore</string>
    <key>CFBundleDisplayName</key>
    <string>Lore</string>
    <key>CFBundleIdentifier</key>
    <string>com.lore.app</string>
    <!-- CFBundleVersion is a placeholder that build.sh and release.sh always overwrite
         in the bundle with <major.minor>.<git commit count>. Deliberately "0" so it can
