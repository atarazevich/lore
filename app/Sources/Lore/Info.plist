    <string>0</string>
    <!-- CFBundleShortVersionString is the marketing version, edited by hand:
         each feature bumps the patch, each release bumps the minor. -->
    <key>CFBundleShortVersionString</key>
    <string>2.1.0</string>
    <key>CFBundleExecutable</key>
    <string>Lore</string>
    <key>CFBundleIconFile</key>
